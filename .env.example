# Copy settings into your local .env in the repository root.
# Replace the upstream model names and API keys before `docker compose up`.
# The proxy accepts aliases `chat` and `embeddings`; HyDE uses `chat` too.

# 1. Local proxy credential: generate your own random value, starting with sk-.
# Example generation command: openssl rand -hex 32 (prepend sk- to the result).
LITELLM_MASTER_KEY=sk-CHANGE-ME

# 2. Chat model, used by HyDE now and the agent in the next iteration.
# Use LiteLLM's provider/model notation, e.g. openai/<model-id>,
# anthropic/<model-id>, gemini/<model-id>, openrouter/<vendor>/<model-id>.
# Choose a model that supports tool calling for the future agent.
CHAT_UPSTREAM_MODEL=openai/replace-with-chat-model-id
CHAT_API_KEY=
# Optional custom provider endpoint; leave blank for the provider's default.
# For a model server on this computer use http://host.docker.internal:PORT/v1
# in Docker. A localhost URL would point at the LiteLLM container itself.
CHAT_API_BASE=

# 3. Embedding model. It can use a different provider/key/endpoint.
EMBEDDING_UPSTREAM_MODEL=openai/replace-with-embedding-model-id
EMBEDDING_API_KEY=
EMBEDDING_API_BASE=

# 4. Tavily web search. Leave empty to start without web search;
# web_search_and_index will explain that the key is missing.
TAVILY_API_KEY=

# 5. Ontology to load. Relative paths are resolved from the repository root.
# For the existing ontology beside this repo: ONTOLOGY_PATH=../assignment_1.owl
ONTOLOGY_PATH=./examples/ontologies/minimal.owl
ONTOLOGY_ID=demo
# File syntax: xml = RDF/XML, turtle = Turtle, nt = N-Triples.
ONTOLOGY_FORMAT=xml

# Settings for Python commands run on the HOST with `uv run --env-file .env ...`.
# Compose supplies Docker's internal service URLs automatically.
LITELLM_BASE_URL=http://localhost:4000/v1
QDRANT_URL=http://localhost:6333
EMBEDDING_BACKEND=litellm
EMBEDDING_MODEL=embeddings
HYDE_MODEL=chat
# LITELLM_API_KEY is optional locally: the app falls back to LITELLM_MASTER_KEY.
# Set it separately only when connecting to a proxy with a different client key.
